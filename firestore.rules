rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives (Read-only for rules)
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'kumaraditye9@gmail.com' ||
          request.auth.token.email == 'npaditya53@gmail.com' ||
          request.auth.token.email == 'admin@onebitemotihari.in'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isDeliveryBoy() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'delivery@onebitemotihari.in' ||
          request.auth.token.email == 'deliveryboy@onebitemotihari.in' ||
          request.auth.token.email == 'yoonekaditya.ai@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/delivery_boys/$(request.auth.uid))
      );
    }

    // Connection testing doc
    match /test/{docId} {
      allow read: if true;
    }

    // System initialization marker doc
    match /system/{docId} {
      allow read: if true;
      allow write: if false; 
    }

    // Catalog Collections: Public Read, Server-Only Write (write: if false)
    match /settings/{settingId} { allow read: if true; allow write: if false; }
    match /categories/{categoryId} { allow read: if true; allow write: if false; }
    match /menuItems/{menuItemId} { allow read: if true; allow write: if false; }
    match /gallery/{galleryId} { allow read: if true; allow write: if false; }
    match /offers/{offerId} { allow read: if true; allow write: if false; }
    match /coupons/{couponId} { allow read: if true; allow write: if false; }
    match /businessHours/{dayId} { allow read: if true; allow write: if false; }
    match /reviews/{reviewId} { allow read: if true; allow write: if false; }

    // Orders: Private Read (Customer/Admin/Delivery), Server-Only Write
    match /orders/{orderId} {
      allow get: if isAdmin() || isDeliveryBoy() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow list: if isAdmin() || isDeliveryBoy() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    // Internal Metadata
    match /admins/{adminId} { allow read: if isAdmin(); allow write: if false; }
    match /delivery_boys/{boyId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == boyId);
      allow write: if false;
    }

    // FCM Device Subscriptions: Admin Read, Server-Only Write
    match /deviceSubscriptions/{tokenId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
  }
}

