# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# ADMIN_EMAIL: Restaurant owner admin email login
ADMIN_EMAIL="admin@example.com"

# ADMIN_PASSWORD: Set a strong password for admin access (e.g. 16+ random characters)
ADMIN_PASSWORD="change_this_to_a_secure_password"

# PASSWORD_SALT: Cryptographic salt for PBKDF2 password hashing
PASSWORD_SALT="change_to_a_unique_random_salt_string"

# ADMIN_PASSWORD_HASH: Optional precomputed PBKDF2 hash of admin password
ADMIN_PASSWORD_HASH=""

# APP_URL: The URL where this website is hosted (e.g. https://onebitemotihari.in)
APP_URL=""

# Optional: Server port
PORT="3000"
