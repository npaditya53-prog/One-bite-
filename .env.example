# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# ADMIN_EMAIL: Restaurant owner admin email login
ADMIN_EMAIL="admin@onebitemotihari.in"

# ADMIN_PASSWORD: Set a strong password for admin access
ADMIN_PASSWORD="change_this_to_a_secure_password"

# Optional: Port when running custom server
PORT="3000"
