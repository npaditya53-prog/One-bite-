# One Bite Motihari - Security Configuration
# ==========================================

# 1. Admin Authentication
# -----------------------
# Use a secure bcrypt hash for the admin password.
# To generate a hash for 'onebite2026!':
# ADMIN_PASSWORD_HASH='$2a$10$YourGeneratedHashHere'
ADMIN_PASSWORD_HASH=''

# List of authorized admin emails (comma-separated)
ADMIN_EMAIL='kumaraditye9@gmail.com,npaditya53@gmail.com,admin@onebitemotihari.in'

# 2. Delivery Boy Authentication
# ------------------------------
# Use a secure bcrypt hash for the delivery boy password.
# To generate a hash for '12345':
# DELIVERY_PASSWORD_HASH='$2a$10$YourGeneratedHashHere'
DELIVERY_PASSWORD_HASH=''

# List of authorized delivery boy emails (comma-separated)
DELIVERY_EMAIL='yoonekaditya.ai@gmail.com,delivery@onebitemotihari.in'

# 3. Session Security
# -------------------
# NODE_ENV will be automatically set to 'production' on Vercel.
# HttpOnly and SameSite:Strict cookies are used for session tokens.
NODE_ENV='development'

# 4. WhatsApp Integration
# -----------------------
# Required for automated WhatsApp order notifications via Meta Cloud API.
WHATSAPP_CLOUD_API_TOKEN=''
WHATSAPP_PHONE_NUMBER_ID=''
WHATSAPP_BUSINESS_ACCOUNT_ID=''
WHATSAPP_RECIPIENT_PHONE=''

# 5. Instagram Integration
# ------------------------
# Optional: Required for live Instagram feed synchronization.
INSTAGRAM_ACCESS_TOKEN=''

# 6. PWA & Notifications
# ----------------------
# Public VAPID key for Firebase Cloud Messaging (FCM)
VITE_FIREBASE_VAPID_KEY=''

# 7. WhatsApp Business Cloud API
# ------------------------------
# Official Meta integration secrets. Obtain from Meta App Dashboard.
WHATSAPP_ACCESS_TOKEN=''
WHATSAPP_PHONE_NUMBER_ID=''
WHATSAPP_BUSINESS_ACCOUNT_ID=''
WHATSAPP_VERIFY_TOKEN='onebite_verify_token_2026'
WHATSAPP_APP_SECRET=''
